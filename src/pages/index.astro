---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const title = "Lucy Wilson — Lead Software Engineer · Mobile, Connected Products, Full-stack";
const description =
	"Lead software engineer specialising in mobile and connected products. Sole engineer behind a 1M+ user React Native app — owning the mobile client, backend APIs, and cloud. Available for contract work.";
---

<BaseLayout {title} {description}>
	<header>
		<div class="header-inner">
			<p class="site-title"><a href="/">Lucy Wilson</a></p>
			<nav aria-label="Primary">
				<ul>
					<li><a href="#expertise">Expertise</a></li>
					<li><a href="#work">Work</a></li>
					<li><a href="#engagements">Engagements</a></li>
					<li><a href="#contact">Contact</a></li>
				</ul>
			</nav>
		</div>
	</header>

	<main id="main">
		<section class="hero" aria-labelledby="hero-heading">
			<p class="hero-badge">Available for contract &amp; full-time employment</p>
			<h1 id="hero-heading">Lead software engineer for mobile and connected products</h1>
			<p class="lead">
				I take mobile and connected products end to end — the React Native client, the backend APIs,
				and the cloud behind them. I've been the sole engineer on a 1M+ user app, designed Bluetooth
				device protocols from scratch, and led IoT security compliance. Bring me in to set technical
				direction, ship hard features, or get a connected product over the line.
			</p>
			<div class="cta-row">
				<a class="button button--primary" href="#contact">Start a conversation</a>
				<a class="button button--ghost" href="#work">View selected work</a>
			</div>
			<div class="proof-bar" role="list" aria-label="Key highlights">
				<div class="proof-item" role="listitem">
					<span class="proof-value">1M+</span>
					<span class="proof-label">annual app users</span>
				</div>
				<div class="proof-item" role="listitem">
					<span class="proof-value">Sole engineer</span>
					<span class="proof-label">mobile, backend &amp; cloud</span>
				</div>
				<div class="proof-item" role="listitem">
					<span class="proof-value">BLE &amp; IoT</span>
					<span class="proof-label">device protocol from scratch</span>
				</div>
				<div class="proof-item" role="listitem">
					<span class="proof-value">AWS &amp; GCP</span>
					<span class="proof-label">cloud &amp; serverless</span>
				</div>
			</div>
		</section>

		<section id="expertise" aria-labelledby="expertise-heading">
			<h2 id="expertise-heading">Expertise</h2>
			<p class="section-intro">
				Mobile and connected products are my specialism — backed by full-stack and cloud ownership
				across the whole product lifecycle.
			</p>
			<div class="card-grid">
				<article class="card">
					<h3>React Native</h3>
					<p>
						Architecture that scales, native modules when needed, the Expo toolchain, and
						offline-first data with WatermelonDB. I migrated a legacy monorepo to Expo and own the
						release process across iOS and Android.
					</p>
				</article>
				<article class="card">
					<h3>Bluetooth &amp; IoT</h3>
					<p>
						BLE integration and device protocol design from scratch, with the spec co-owned by the
						firmware team. I led Ooni's first connected-product capability — real-time, bidirectional
						data between ovens and phones — and its IoT security compliance (ETSI EN 303 645).
					</p>
				</article>
				<article class="card">
					<h3>Full-stack &amp; cloud</h3>
					<p>
						Serverless APIs, Firebase and Google Cloud, AWS IoT Core, and data modelling for mobile
						sync. I build and own the backend the app depends on — including a zero-data-loss auth
						migration to Firebase.
					</p>
				</article>
				<article class="card">
					<h3>Delivery &amp; CI/CD</h3>
					<p>
						Mobile CI/CD pipelines and automated releases that keep delivery predictable, plus a
						Shopify-driven automation that ships new products with minimal app changes.
					</p>
				</article>
				<article class="card">
					<h3>Accessibility</h3>
					<p>
						Inclusive defaults built in from the start — screen-reader coverage, contrast, and
						focus. I've delivered for users with dyslexia, visual impairments, and reduced motor
						skills.
					</p>
				</article>
				<article class="card">
					<h3>AI-assisted delivery</h3>
					<p>
						I lead AI engineering enablement across the team, introducing tooling that lifts delivery
						speed and quality — always paired with human review on edge cases, security, and UX.
					</p>
				</article>
			</div>
		</section>

		<section id="work" aria-labelledby="work-heading">
			<h2 id="work-heading">Selected work</h2>
			<p class="section-intro">
				Recent work across consumer hardware and assistive technology.
			</p>
			<div class="project-list">
				<article class="project">
					<div>
						<p class="project-meta">Consumer hardware · Sep 2023 – Present</p>
						<h3>Ooni — smart oven companion app</h3>
					</div>
					<div>
						<p>
							After joining a small team, I quickly became the sole mobile and full-stack engineer on Ooni's React Native app (1M+ annual users). I
							architected Ooni Connect — their first Bluetooth integration — enabling real-time,
							bidirectional data between smart ovens and phones, designed a new BLE device protocol
							from scratch with the firmware team, and led IoT security compliance (ETSI EN 303
							645). I built an offline-first platform on WatermelonDB and serverless APIs, migrated
							auth to Firebase / GCP with zero data loss, and replatformed a legacy monorepo to Expo and Netlify, for simple updates, and fast releases
						</p>
						<ul class="tag-list" aria-label="Technologies">
							<li class="tag">React Native</li>
							<li class="tag">TypeScript</li>
							<li class="tag">Expo</li>
							<li class="tag">Bluetooth / BLE</li>
							<li class="tag">AWS IoT Core</li>
							<li class="tag">Firebase / GCP</li>
							<li class="tag">WatermelonDB</li>
							<li class="tag">Node / Serverless</li>
						</ul>
					</div>
				</article>
				<article class="project">
					<div>
						<p class="project-meta">Education &amp; assistive tech · Aug 2020 – Sep 2023</p>
						<h3>Present Pal — accessible communication app</h3>
					</div>
					<div>
						<p>
							I was the senior React Native developmer for Present Pal, making public speaking more accessible
							for users with dyslexia, visual impairments, and reduced motor skills. I shipped
							consistent experiences across iOS and Android (phones and tablets), mentored a 4-person
							team — driving architecture and code review — and extended a PHP / Laravel backend to
							enable new features. Introduced unit testing in TypeScript and PHP with Jest.
						</p>
						<ul class="tag-list" aria-label="Technologies">
							<li class="tag">React Native</li>
							<li class="tag">TypeScript</li>
							<li class="tag">iOS &amp; Android</li>
							<li class="tag">Accessibility</li>
							<li class="tag">PHP / Laravel</li>
							<li class="tag">Jest</li>
						</ul>
					</div>
				</article>
			</div>
		</section>

		<section id="engagements" aria-labelledby="engagements-heading">
			<h2 id="engagements-heading">How we can work together</h2>
			<p class="section-intro">
				A few ways I work with teams, depending on where your product is.
			</p>
			<div class="engagement">
				<article>
					<h3>Lead Engineer</h3>
					<p>
						Ongoing architecture, reviews, and pairing — for teams that need senior engineering
						direction and a full-lifecycle perspective.
					</p>
				</article>
				<article>
					<h3>Project delivery</h3>
					<p>
						Scoped milestones from prototype to store submission, with clear handoff docs. I own the
						full stack when needed.
					</p>
				</article>
				<article>
					<h3>Advisory</h3>
					<p>
						Short audits on BLE reliability, IoT architecture, performance, accessibility, or release
						process — with actionable next steps.
					</p>
				</article>
			</div>
		</section>

		<section id="contact" aria-labelledby="contact-heading">
			<div class="contact-panel">
				<h2 id="contact-heading">Tell me about your product</h2>
				<p>
					Share stack, timeline, and what "done" looks like. Message me on LinkedIn and I'll reply
					within two business days with availability and next steps.
				</p>
				<a
					class="button button--primary"
					href="https://www.linkedin.com/in/lucy-wilson-289437158/"
					>Message me on LinkedIn</a
				>
			</div>
		</section>
	</main>

	<footer>
		<div class="footer-inner">
			<p>© {new Date().getFullYear()} Lucy Wilson. Glasgow, UK — working globally.</p>
			<p>
				<a href="https://www.linkedin.com/in/lucy-wilson-289437158/">LinkedIn</a>
			</p>
		</div>
	</footer>
</BaseLayout>
